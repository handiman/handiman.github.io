---
layout: page
title: Henrik Becker CV
headings: 
  summary: Introduction
  education: Education
  languages: Languages
  core_competencies: Core Competencies
  employment: Work Experience
  experience: Work Experience
  projects: Projects
  earlier_career: Earlier Career
  certs: Certifications
  tech_stack: Tech & Methods
  recommendations: Recommendations
  interests: Interests
  all_roles: Roles
  all_skills: All skills
  skills_by_category: Skills
  location: Location
  taglines: Taglines
  usps: Unique Selling Points
  clients: Clients
  short_cv: Short version
  selected_experience: Selected experience
  earlier: Earlier
  and_more: and more
  see_full_cv: see the full CV
  other_formats: Other formats
  download_pdf: Download PDF
  other_language: På svenska
  present: present
# Jobs can set `key_highlight` in their front matter: one result shown on the web CV.
# Work history from this date on is listed on the web CV; everything before it
# is summed up in one line. The full history is in the PDF.
short_cv_since: 2014-11-01
---
{%- if lang == "sv" -%}
  {%- assign pdf_url = "/sv/assets/henrik-becker.pdf" -%}{%- assign other_url = "/cv/" -%}{%- assign other_lang = "en" -%}
  {%- assign experience_items = collections.experience_sv -%}{%- assign earlier_items = collections.earlier_career_sv -%}
  {%- assign education_items = collections.education_sv -%}{%- assign project_items = collections.projects_sv -%}
{%- else -%}
  {%- assign pdf_url = "/assets/henrik-becker.pdf" -%}{%- assign other_url = "/sv/cv/" -%}{%- assign other_lang = "sv" -%}
  {%- assign experience_items = collections.experience -%}{%- assign earlier_items = collections.earlier_career -%}
  {%- assign education_items = collections.education -%}{%- assign project_items = collections.projects -%}
{%- endif -%}
{%- assign recent = experience_items | startedSince: short_cv_since -%}
{%- assign older = experience_items | startedSince: short_cv_since, true -%}
{%- assign cv_lang = lang | default: "en" -%}
<header class="cv-head no-print">
    <div class="cv-head__id">
        <div class="cv-head__photo">
            <picture>
                <source type="image/webp" srcset="/assets/img/henrik-becker-square.webp">
                <img src="/assets/img/henrik-becker-square.jpg" width="400" height="400" alt="{{ person.name }}">
            </picture>
        </div>
        <div class="cv-head__text">
            <p class="label">CV · {{ headings.short_cv }}</p>
            <h1>{{ person.name }}</h1>
            <p class="cv-head__title">{{ person.jobTitle }} · Lidingö</p>
        </div>
    </div>
    <div class="cv-head__actions">
        <a class="button button--small" href="{{ pdf_url }}"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v8M4.5 6.5L8 10l3.5-3.5M3 13h10"/></svg> {{ headings.download_pdf }}</a>
        <a class="button button--ghost" href="{{ other_url }}" hreflang="{{ other_lang }}" lang="{{ other_lang }}">{{ headings.other_language }}</a>
    </div>
</header>

<p class="cv-summary" id="introduction" data-source="{{ page.url }}#introduction">{{ summary }}</p>

<div class="cv-short">
    <div class="cv-short__main">

        <h2 class="label cv-short__first">{{ headings.selected_experience }}</h2>
        {%- for xp in recent %}
        {%- capture start_year %}{{ xp.data.start_date | date: '%Y' }}{% endcapture -%}
        {%- if xp.data.end_date == "present" -%}{%- assign end_year = headings.present -%}{%- else -%}{%- capture end_year %}{{ xp.data.end_date | date: '%Y' }}{% endcapture -%}{%- endif %}
        <article class="cv-entry" id="{{ xp.fileSlug }}">
            <p class="cv-entry__years">{% if start_year == end_year %}{{ start_year }}{% else %}{{ start_year }} — {{ end_year }}{% endif %}</p>
            <div class="cv-entry__body">
                <h3 class="cv-entry__head"><a class="cv-entry__name" href="{{ xp.url }}">{{ xp.data.title }}</a>{% if xp.data.roles %} <span class="cv-entry__role">{{ xp.data.roles | join: ", " }}</span>{% endif %}</h3>
                {% if xp.data.description %}<div class="cv-entry__summary">{{ xp.data.description | markdownify }}</div>{% endif %}
                {% if xp.data.key_highlight %}<p class="cv-entry__highlight">{{ xp.data.key_highlight }}</p>{% endif %}
                {% if xp.data.skills %}<p class="cv-entry__tech">{{ xp.data.skills | slice: 0, 5 | join: " · " }}</p>{% endif %}
            </div>
        </article>
        {%- endfor %}
        {%- capture earlier_names -%}
        {%- assign shown = 0 -%}
        {%- for xp in older -%}{%- if shown < 6 -%}{%- if shown > 0 %}, {% endif %}{{ xp.data.title }}{%- assign shown = shown | plus: 1 -%}{%- endif -%}{%- endfor -%}
        {%- endcapture %}
        <div class="cv-entry cv-entry--earlier">
            <p class="cv-entry__years">{{ headings.earlier }}</p>
            <p>{{ earlier_names }} {{ headings.and_more }} — <a href="{{ pdf_url }}">{{ headings.see_full_cv }}</a>.</p>
        </div>

        {%- assign quote = recommendations | first %}
        <figure class="cv-quote no-print">
            <blockquote>
                <p>{{ quote.text }}</p>
                <footer>{{ quote.name }}</footer>
            </blockquote>
        </figure>
    </div>

    <aside class="cv-short__aside">
        <section>
            <h2 class="label">{{ headings.core_competencies }}</h2>
            <ul>{% for skillCategory in coreSkills %}
                <li>{{ skillCategory.name }}{% if skillCategory.skills %} <span>({{ skillCategory.skills | join: ', ' }})</span>{% endif %}</li>{% endfor %}
            </ul>
        </section>
        <section>
            <h2 class="label">{{ headings.certs }}</h2>
            {% for cert in certs %}<div class="cv-aside__item"><span>{{ cert.title }}</span><span>{{ cert.issuer }} · {{ cert.achievement_date | date: '%Y' }}</span></div>
            {% endfor %}
        </section>
        <section>
            <h2 class="label">{{ headings.languages }}</h2>
            <ul>{% for language in languages %}<li>{{ language.name }} — {{ language.proficiency }}</li>{% endfor %}</ul>
        </section>
        <section>
            <h2 class="label">{{ headings.education }}</h2>
            {% for education in education_items %}<div class="cv-aside__item"><a href="{{ education.url }}">{{ education.data.title }}</a><span>{{ education.data.start_year }}{% if education.data.end_year %} — {{ education.data.end_year }}{% endif %}</span></div>
            {% endfor %}
        </section>
        <section>
            <h2 class="label">{{ headings.projects }}</h2>
            {% for project in project_items %}<a class="cv-aside__row" href="{{ project.url }}"><span>{{ project.data.title }}</span><span>{{ project.data.start_date | date: '%Y' }}</span></a>
            {% endfor %}
        </section>
        <section class="cv-aside__formats no-print">
            <h2 class="label">{{ headings.other_formats }}</h2>
            <div>{% for format in formats %}{% assign format_lang = format.lang | default: "en" %}{% if format_lang == cv_lang and format.name != "PDF" %}<a href="{{ format.url }}">{{ format.name }}</a>{% endif %}{% endfor %}</div>
        </section>
    </aside>
</div>

{%- comment -%}
  The full CV. Not shown on the page (the PDF covers that), but kept in the HTML
  so the CV chat ingestion (ingest.yml fetches /cv) still sees the whole history.
{%- endcomment %}
<template id="full-cv">


<section id="introduction" data-source="{{ page.url }}#introduction">
    <h2>{{ headings.summary }}</h2>
    <p>{{ summary }}</p>
</section>
<div class="cv-facts">
<section id="core-competencies" data-source="{{ page.url }}#core-competencies">
    <h2>{{ headings.core_competencies }}</h2>
    <ul>{% for skillCategory in coreSkills %}
        <li>{{ skillCategory.name }}{% if skillCategory.skills %} ({{ skillCategory.skills | join: ', ' }}){% endif %}
        </li>{% endfor %}
    </ul>
</section>
<section id="languages" data-source="{{ page.url }}#languages" data-section="Languages">
    <h2>{{ headings.languages }}</h2>
    <ul>{% for language in languages %}<li><strong>{{ language.name }}:</strong> {{ language.proficiency }}</li>{%
        endfor %}</ul>
</section>
<section id="certifications" data-source="{{ page.url }}#certifications" data-section="Certifications">
    <h2>{{ headings.certs }}</h2>
    <ul>{% for cert in certs %}<li><strong>{{ cert.title }}:</strong> {% if cert.issuer %}{{ cert.issuer }} {% endif
            %}{% if cert.achievement_date %}(<date>{{ cert.achievement_date }}</date>){% endif %}</li>{% endfor %}</ul>
</section>
</div>
<section id="work-experience">
    {% include 'work-experience' %}
    {% include 'projects' %}
    {% include 'earlier-career' %}
</section>
<section id="education" data-source="{{ page.url }}#education" data-section="Education">
    <h2>{{ headings.education }}</h2>
    {% assign education_items = collections.education %}
    {% if lang == "sv" %}{% assign education_items = collections.education_sv %}{% endif %}
    {% for education in education_items %}
    <article class="education">
        <header>
            <h3><a href="{{ education.url }}">{{ education.data.title }}</a></h3>
            <time>{% if education.data.start_year %}{{ education.data.start_year }}{% endif %} &dash; {% if
                education.data.end_year %}{{ education.data.end_year }}{% else %}present{% endif %}</time>
        </header>
        <em>{{ education.data.description }}</em>
    </article>{% endfor %}
</section>
<section id="recommendations" data-source="{{ page.url }}#recommendations" data-section="Recommendations">
    <h2>{{ headings.recommendations }}</h2>{% for recommendation in recommendations %}
    <blockquote>
        <p>{{ recommendation.text }}</p>
        <footer>- {{ recommendation.name }}</footer>
    </blockquote>{% endfor %}
</section>
</template>
<template id="all-roles">
    <h2>{{ headings.all_roles }}</h2> 
    <p>{{ collections.all_roles | join: ", " }}</p>
</template>
<template id="all-skills">
    <h2>{{ headings.all_skills }}</h2> 
    <p>{{ collections.all_skills | join: ", " }}</p>
</template>
<template id="skills-by-category">
    <h2>{{ headings.skills_by_category }}</h2><div>{% for skillCategory in categorizedSkills %}{% capture skillCategorySlug %}{{ skillCategory.name | replace: '/', '-' | replace: ' ', '-' | replace: '--', '' | downcase }}{% endcapture %}
    <article title="{{ skillCategory.name }} - {{ skillCategory.level }}" data-section="Skills by Category - {{ skillCategory.name }}" data-level="{{ skillCategory.level }}" data-source="{{ page.url | absolute_url }}#{{ skillCategorySlug }}">
        <h3>{{ skillCategory.name }}</h3>
        <ul>{% for skill in skillCategory.skills %}<li title="{{ skill }} - {{ skillCategory.level }}">{{ skill }}</li>{% endfor %}</ul>
    </article>{% endfor %}</div>
</template>   
<template id="interests">
    <h2>{{ headings.interests }}</h2>
    <ul>{% for interest in interests %}
        <li>{{ interest.name }}</li>{% endfor %}
    </ul>
</template>
<template id="location">
    <h2>{{ headings.location }}</h2>
    <p>Lidingö, Stockholm, Sweden</p>
    <h2>Birth date</h2>
    <p>
        <date>{{ person.birthDate }}</date>
    </p>
</template>
<template id="taglines">
    <h2>{{ headings.taglines }}</h2>
    <ul>{% for tagline in taglines %}
        <li>{{ tagline.tagline }}</li>{% endfor %}
        <li>
            <h3>Building the right software right</h3>
            <p>
                I believe great software starts with the right conversations. While many developers focus on building
                software the right way — clean code, scalable architecture, elegant design — I go one step further: I
                make sure we're building the right software to begin with.
                That means diving deep into business needs, challenging assumptions, and translating complexity into
                clarity. I bridge the gap between stakeholders and systems, turning fuzzy ideas into functional products
                that deliver real value.
                Whether I’m prototyping a new feature, leading a team, or refining a user flow, I bring a mindset that’s
                equal parts strategic, technical, and creative.
                Let’s build something that matters — and build it well.
            </p>
        </li>
    </ul>
</template>
<template id="unique-selling-points">
    <h2>{{ headings.usps }}</h2>
    <ul>{% for usp in collections.usps %}<li>{{ usp.data.page.excerpt | strip | markdownify | replace: '<p>', '' | replace: '</p>', '' }}</li>{% endfor %}</ul>
</template>
<template id="clients" data-source="{{ page.url | absolute_url }}#clients">
    <h2>{{ headings.clients }}</h2>
    <ul>{% for client in collections.clients reversed %}
        <li><a href="{{ client.url | absolute_url }}">{{client.data.name}}</a></li>{% endfor %}
    </ul>
</template>