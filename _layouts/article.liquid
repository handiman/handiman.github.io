---
layout: reading
---
{%- comment -%} A plain content page: breadcrumb, title, optional lead, prose, and an optional recommendation (front matter `quote:` index into recommendations). {%- endcomment -%}
<header>
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="{{ headings.ui.home_url }}">{{ headings.ui.home }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ breadcrumb | default: title }}</span></nav>
    <h1>{{ title }}</h1>
    {% if lead %}<p class="lead">{{ lead }}</p>{% endif %}
</header>
<div class="prose">
    {{ content }}
    {%- if quote != nil %}
    {%- assign recommendation = recommendations[quote] %}
    <blockquote>
        <p>{{ recommendation.text }}</p>
        <p>{{ recommendation.name }}</p>
    </blockquote>
    {%- endif %}
</div>
