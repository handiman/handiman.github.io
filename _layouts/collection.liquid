---
layout: page
---
{%- if tags contains "usps" -%}{%- assign crumb_label = "How I work" -%}{%- assign crumb_url = "/unique-selling-points/" -%}
{%- elsif tags contains "fun-facts" -%}{%- assign crumb_label = "Fun Facts" -%}{%- assign crumb_url = "/fun-facts/" -%}
{%- else -%}{%- assign crumb_label = "CV" -%}{%- if lang == "sv" -%}{%- assign crumb_url = "/sv/cv/" -%}{%- else -%}{%- assign crumb_url = "/cv/" -%}{%- endif -%}{%- endif -%}
<div class="reading" data-section="{{ title }}" data-source="{{ page.url | absolute_url }}">
    <article>
        <header class="page-head">
            <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="{{ crumb_url }}">{{ crumb_label }}</a></nav>
            <h1>{{ title }}</h1>
        </header>
        <div class="prose">
            {{ content }}
        </div>
    </article>
</div>
