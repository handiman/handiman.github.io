---
layout: page
---
{%- assign post_date = page.date | date: '%Y-%m-%d' -%}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BlogPosting","headline":{{ title | jsonify }},"description":{{ metaDescription | jsonify }},"datePublished":{{ page.date | date: '%Y-%m-%dT%H:%M:%SZ' | jsonify }},"url":{{ page.url | absolute_url | jsonify }},"mainEntityOfPage":{{ page.url | absolute_url | jsonify }},"inLanguage":"en","image":{{ person.image | jsonify }},"author":{"@type":"Person","name":{{ person.name | jsonify }},"url":"https://www.henrikbecker.net/"}{% if original_url %},"sameAs":{{ original_url | jsonify }}{% endif %}}</script>
<div class="reading" data-section="{{ title }}" data-source="{{ page.url | absolute_url }}">
    <article class="post">
        <header class="page-head">
            <nav class="breadcrumb" aria-label="Breadcrumb"><a href="{{ headings.ui.home_url }}">{{ headings.ui.home }}</a><span aria-hidden="true">/</span><a href="/blog/">Blog</a></nav>
            <h1>{{ title }}</h1>
            <p class="page-meta"><time datetime="{{ post_date }}">{{ post_date }}</time></p>
            {% if description %}<p class="lead">{{ description }}</p>{% endif %}
        </header>
        <div class="prose">
            {{ content }}
        </div>
        <footer class="post-footer no-print">
            <a class="link-underline" href="/blog/">← All posts</a>
            {% if original_url %}<a class="post-footer__origin" href="{{ original_url }}">{{ original_label | default: "Originally posted on LinkedIn" }}</a>{% endif %}
        </footer>
    </article>
</div>
