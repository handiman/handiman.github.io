<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="{{ lang }}">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ metaTitle | escape }}</title>
    <meta name="description" content="{{ metaDescription | escape }}" />
    {% if robots %}<meta name="robots" content="{{ robots }}" />
    {% endif %}
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","author":{"@type":"Person","name":{{ person.name | jsonify }},"url":{{ baseUrl | jsonify }}},"headline":{{ person.name | jsonify }},"image":{"alt":{{ person.name | jsonify }},"height":534,"width":800,"url":{{ person.image | jsonify }},"@type":"imageObject"},"name":{{ person.name | jsonify }},"url":{{ baseUrl | jsonify }}}</script>
    <script type="application/ld+json">{{ company | jsonify }}</script>
    <script type="application/ld+json">{{ person | jsonify }}</script>
    <meta name="author" content="{{ person.name }}" />
    <meta property="og:locale" content="{{ ogLocale }}" />
    <meta property="og:title" content="{{ metaTitle | escape }}" />
    <meta property="og:description" content="{{ metaDescription | escape }}" />
    <meta property="og:url" content="{{ page.url | absolute_url }}" />
    <meta property="og:site_name" content="{{ person.name }}" />
    <meta property="og:image" content="{{ '/assets/img/landscape-800x534.jpg' | absolute_url }}" />
    <meta property="og:image:height" content="534" />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:alt" content="{{ person.name }}" />
    <meta property="og:type" content="{{ ogType }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="{{ '/assets/img/landscape-800x534.jpg' | absolute_url }}" />
    <meta name="twitter:image:alt" content="{{ person.name }}" />
    <meta name="twitter:title" content="{{ metaTitle | escape }}" />
    <meta name="twitter:description" content="{{ metaDescription | escape }}" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="stylesheet" href="/assets/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/handiman/henrikbecker.net.chat.ui@0.0.26/dist/collection/cv-chat.css" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F2F1F1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171517" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href="/assets/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/assets/main.css" />
    <link rel="canonical" href="{{ page.url | absolute_url }}" />
    <link rel="alternate" type="application/atom+xml" title="{{ person.name }} — Blog" href="/blog/feed.xml" />
    <link rel="alternate" type="application/rss+xml" title="{{ person.name }} — Blog" href="/blog/rss.xml" />
    {% assign self = collections.all | findByInputPath: page.inputPath %}{% assign alternates = self | hreflangAlternates: collections.all %}{% for alt in alternates %}<link rel="alternate" hreflang="{{ alt.lang }}" href="{{ alt.href }}" />
    {% endfor %}{% for format in formats %}<link rel="alternate" type="{{ format.mime_type }}" title="{{ headings.meta.cv_format }} {{ format.name }} ({{ format.lang | default: 'en' }})" href="{{ format.url }}" />
    {% endfor %}
    <script type="module">
        import { defineCustomElements } from 'https://cdn.jsdelivr.net/gh/handiman/henrikbecker.net.chat.ui@0.0.26/dist/esm/loader.js';
        defineCustomElements();
    </script>        
</head>
<body class="{% if page.url == '/' or page.url == '/sv/' %}site-home{% endif %}{% if class %} {{ class }}{% endif %}">
  {{ content }}
  <button class="theme-toggle" title="Toggle dark mode">.</button>
  <script src="/assets/main.js"></script>
</body>
</html>         