---
layout: page
---
{%- comment -%} Home page. Copy lives in the front matter of index.html (English) and index.sv.html (Swedish). {%- endcomment %}
<section class="hero" id="introduction" data-source="{{ page.url | absolute_url }}#introduction">
    <h2 class="hidden">{{ labels.introduction }}</h2>
    <div class="hero__text">
        <div class="hero__id">
            <div class="hero__avatar">
                <picture>
                    <source type="image/webp" srcset="/assets/img/henrik-becker-square.webp">
                    <img src="/assets/img/henrik-becker-square.jpg" width="400" height="400" alt="" loading="lazy">
                </picture>
            </div>
            <div class="hero__heading">
                <p class="label">{{ hero.label | escape | replace: " · ", "&nbsp;· " }}</p>
                <h1>{{ hero.title | escape }}</h1>
            </div>
        </div>
        <p class="hero__intro">{{ ingress }}</p>
        <div class="hero__actions">
            <a class="button" href="{{ headings.ui.cv_url }}">{{ hero.cta | escape }} <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
            <button type="button" class="link-underline" data-ask>{{ hero.secondary | escape }}</button>
        </div>
        <div class="hero__questions no-print">
            <span class="label">{{ hero.questions_label | escape }}</span>
            {%- for question in hero.questions %}
            <button type="button" class="ask-chip" data-ask="{{ question | escape }}">{{ question | escape }}</button>
            {%- endfor %}
        </div>
    </div>
    <div class="hero__photo">
        <picture>
            <source media="(max-width: 900px)" type="image/webp" srcset="/assets/img/henrik-becker-square.webp">
            <source type="image/webp" srcset="/assets/img/henrik-becker-800.webp 800w, /assets/img/henrik-becker-1200.webp 1200w" sizes="(max-width: 900px) 100vw, 640px">
            <img src="/assets/img/henrik-becker-1200.jpg" srcset="/assets/img/henrik-becker-800.jpg 800w, /assets/img/henrik-becker-1200.jpg 1200w" sizes="(max-width: 900px) 100vw, 640px" width="1200" height="1125" alt="{{ person.name }}" fetchpriority="high">
        </picture>
    </div>
</section>
<section id="offer" data-source="{{ page.url | absolute_url }}#offer">
    <h2>{{ labels.offer }}</h2>
    <ul class="services">
        {% for card in cards %}
        <li>
            <h3>{{ card.front }}</h3>
            <div>{{ card.back }}</div>
        </li>
        {% endfor %}
    </ul>
    <p><a class="link-underline" href="{{ labels.working_with_me_url }}">{{ labels.working_with_me }}</a></p>
</section>
<section id="unique-selling-points" data-source="{{ page.url }}#unique-selling-points">
    <h2><a href="{{ headings.ui.usps_url }}">{{ headings.ui.how_i_work }}</a></h2>
    {% include 'usps' %}
</section>
<section id="clients" data-source="{{ page.url  }}#clients">
    <h2 class="label">{{ labels.clients }}</h2>
    <ul class="client-logos">{% for client in collections.clients %}{% if client.data.logo %}
        <li title="{{ client.data.title }}">
            <img class="client-logo" src="{{ client.data.logo }}" alt="{{ client.data.title }} {{ labels.logo }}" />
        </li>{% endif %}{% endfor %}
    </ul>
</section>
