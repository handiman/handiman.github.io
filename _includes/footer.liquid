<footer class="site-footer" role="contentinfo">
    <div class="wrap site-footer__inner">
        <p class="site-footer__legal">{{ company.name }} · {{ headings.ui.org_nr }} {{ site.orgNumber }} · {{ headings.ui.registered }}</p>
        <p class="site-footer__links">
            {%- for social in same_as %}
            <a href="{{ social.url }}">{{ social.network }}</a>
            {%- endfor %}
        </p>
    </div>
</footer>
