 <ul class="cards">
    {% if lang == "sv" %}{% assign usps = collections.usps_sv %}{% else %}{% assign usps = collections.usps %}{% endif %}
    {% for usp in usps %}
    <li class="card">
        <h3>{{ usp.data.title }}</h3>
        <div class="card-body">
            {{ usp.data.page.excerpt | markdownify }}
            {% unless usp.no_link==true %}<a class="more" href="{{ usp.url }}">{{ headings.ui.read_more }}</a>{% endunless %}
        </div>
    </li>
    {% endfor %}
</ul>