<article class="experience" id="{{ xp.fileSlug }}" data-section="{{ xp.data.organization.name }}" data-source="{{ xp.url }}#{{ xp.fileSlug }}">
    <header>
        <h3><a href="{{ xp.url }}">{{ xp.data.roles | join: " & " }} - {{ xp.data.title }}</a>{% if xp.data.via %} <small>(via {{ xp.data.via | join: ', ' }})</small>{% endif %}</h3>
        <time>
            <span>{{ xp.data.start_date | date: '%Y-%m'}}</span>
            <span>{{ xp.data.end_date | date: '%Y-%m' }}</span>
        </time>
    </header>
    {% if xp.data.description %}<p>{{ xp.data.description | markdownify }}</p>{% endif %}
    {% if xp.data.comment %}<p>{{ xp.data.comment | markdownify }}</p>{% endif %}
    {% if xp.data.highlights %}
        <ul class="highlights">{% for highlight in xp.data.highlights %}
            <li>{{ highlight }}</li>{% endfor %}
        </ul>
    {% endif %}
    {% if xp.data.skills %}
        <div class="tech-stack">
            <h4>{{ headings.tech_stack }}:</h4>
            <ul>{% for skill in xp.data.skills %}
                <li>{{ skill }}</li>{% endfor %}
            </ul>
        </div>
    {% endif %}
</article>