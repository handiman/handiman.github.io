{%- comment -%}
  The short CV, used by the CV page (_layouts/cv.liquid) and by the fragments
  /assets/short-cv.html and /sv/assets/short-cv.html that becker-consulting.se shows.
  cv_base: prefix for links and images ("" here, the production URL in the fragments).
  cv_other_url: link for the "other language" button (the fragments leave a placeholder
  that becker-consulting.se replaces with its own CV page).
{%- endcomment -%}
{%- assign cv_base = cv_base | default: "" -%}
{%- if lang == "sv" -%}
  {%- assign pdf_url = "/sv/assets/henrik-becker.pdf" -%}{%- assign other_url = "/cv/" -%}{%- assign other_lang = "en" -%}
  {%- assign experience_items = collections.experience_sv -%}{%- assign earlier_items = collections.earlier_career_sv -%}
  {%- assign education_items = collections.education_sv -%}{%- assign project_items = collections.projects_sv -%}
{%- else -%}
  {%- assign pdf_url = "/assets/henrik-becker.pdf" -%}{%- assign other_url = "/sv/cv/" -%}{%- assign other_lang = "sv" -%}
  {%- assign experience_items = collections.experience -%}{%- assign earlier_items = collections.earlier_career -%}
  {%- assign education_items = collections.education -%}{%- assign project_items = collections.projects -%}
{%- endif -%}
{%- assign recent = experience_items | startedSince: site.shortCvSince -%}
{%- assign older = experience_items | startedSince: site.shortCvSince, true -%}
{%- assign cv_lang = lang | default: "en" -%}
{%- assign pdf_url = cv_base | append: pdf_url -%}
{%- if cv_other_url -%}{%- assign other_url = cv_other_url -%}{%- endif -%}
{%- comment -%} Business card at the top of the printed CV. Not shown on screen. {%- endcomment %}
<div class="print-card print">
    <picture>
        <img src="{{ cv_base }}/assets/img/portrait-800x1199.jpg" alt="Photo of Henrik Becker" width="800" height="1199" />
    </picture>
    <div>
        <p class="print-card__name">{{ person.name }}</p>
        <p>{{ person.jobTitle }}</p>
        <ul>
            <li><svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg> <span class="flip-text">&#51;&#52;&#32;&#51;&#56;&#32;&#50;&#50;&#52;&#32;&#51;&#55;&#32;&#54;&#52;&#43;</span></li>
            <li><svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg> <span class="flip-text">&#101;&#115;&#46;&#103;&#110;&#105;&#116;&#108;&#117;&#115;&#110;&#111;&#99;&#45;&#114;&#101;&#107;&#99;&#101;&#98;&#64;&#107;&#105;&#114;&#110;&#101;&#104;</span></li>
            <li><svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg> www.henrikbecker.net</li>
            </ul>
    </div>
</div>
<header class="cv-head no-print">
    <div class="cv-head__id">
        <div class="cv-head__photo">
            <picture>
                <source type="image/webp" srcset="{{ cv_base }}/assets/img/henrik-becker-square.webp">
                <img src="{{ cv_base }}/assets/img/henrik-becker-square.jpg" width="400" height="400" alt="{{ person.name }}">
            </picture>
        </div>
        <div class="cv-head__text">
            <p class="label">CV · {{ headings.short_cv }}</p>
            <h1>{{ person.name }}</h1>
            <p class="cv-head__title">{{ person.jobTitle }} · Lidingö</p>
        </div>
    </div>
    <div class="cv-head__actions">
        <a class="button button--small" href="{{ pdf_url }}"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v8M4.5 6.5L8 10l3.5-3.5M3 13h10"/></svg> {{ headings.download_pdf }}</a>
        <a class="button button--ghost" href="{{ other_url }}" hreflang="{{ other_lang }}" lang="{{ other_lang }}">{{ headings.other_language }}</a>
    </div>
</header>

<p class="cv-summary" id="introduction" data-source="{{ page.url }}#introduction">{{ summary }}</p>

<div class="cv-short">
    <div class="cv-short__main">

        <h2 class="label cv-short__first">{{ headings.selected_experience }}</h2>
        {%- for xp in recent %}
        {%- capture start_year %}{{ xp.data.start_date | date: '%Y' }}{% endcapture -%}
        {%- if xp.data.end_date == "present" -%}{%- assign end_year = headings.present -%}{%- else -%}{%- capture end_year %}{{ xp.data.end_date | date: '%Y' }}{% endcapture -%}{%- endif %}
        <article class="cv-entry" id="{{ xp.fileSlug }}">
            <p class="cv-entry__years">{% if start_year == end_year %}{{ start_year }}{% else %}{{ start_year }} — {{ end_year }}{% endif %}</p>
            <div class="cv-entry__body">
                <h3 class="cv-entry__head"><a class="cv-entry__name" href="{{ cv_base }}{{ xp.url }}">{{ xp.data.title }}</a>{% if xp.data.roles %} <span class="cv-entry__role">{{ xp.data.roles | join: ", " }}</span>{% endif %}</h3>
                {% if xp.data.description %}<div class="cv-entry__summary">{{ xp.data.description | markdownify }}</div>{% endif %}
                {% if xp.data.key_highlight %}<p class="cv-entry__highlight">{{ xp.data.key_highlight }}</p>{% endif %}
                {% if xp.data.skills %}<p class="cv-entry__tech">{{ xp.data.skills | slice: 0, 7 | join: " · " }}</p>{% endif %}
            </div>
        </article>
        {%- endfor %}
        {%- capture earlier_names -%}
        {%- assign shown = 0 -%}
        {%- for xp in older -%}{%- if shown < 6 -%}{%- if shown > 0 %}, {% endif %}{{ xp.data.title }}{%- assign shown = shown | plus: 1 -%}{%- endif -%}{%- endfor -%}
        {%- endcapture %}
        <div class="cv-entry cv-entry--earlier">
            <p class="cv-entry__years">{{ headings.earlier }}</p>
            <p>{{ earlier_names }} {{ headings.and_more }} — <a href="{{ pdf_url }}">{{ headings.see_full_cv }}</a>.</p>
        </div>

        <div class="cv-quotes no-print">
            {%- for recommendation in recommendations %}
            <figure class="cv-quote">
                <blockquote>
                    <p>{{ recommendation.text }}</p>
                    <footer>{{ recommendation.name }}</footer>
                </blockquote>
            </figure>
            {%- endfor %}
        </div>
    </div>

    <aside class="cv-short__aside">
        <section>
            <h2 class="label">{{ headings.core_competencies }}</h2>
            <ul>{% for skillCategory in coreSkills %}
                <li>{{ skillCategory.name }}{% if skillCategory.skills %} <span>({{ skillCategory.skills | join: ', ' }})</span>{% endif %}</li>{% endfor %}
            </ul>
        </section>
        <section>
            <h2 class="label">{{ headings.certs }}</h2>
            {% for cert in certs %}<div class="cv-aside__item"><span>{{ cert.title }}</span><span>{{ cert.issuer }} · {{ cert.achievement_date | date: '%Y' }}</span></div>
            {% endfor %}
        </section>
        <section>
            <h2 class="label">{{ headings.languages }}</h2>
            <ul>{% for language in languages %}<li>{{ language.name }} — {{ language.proficiency }}</li>{% endfor %}</ul>
        </section>
        <section>
            <h2 class="label">{{ headings.education }}</h2>
            {% for education in education_items %}<div class="cv-aside__item"><a href="{{ cv_base }}{{ education.url }}">{{ education.data.title }}</a><span>{{ education.data.start_year }}{% if education.data.end_year %} — {{ education.data.end_year }}{% endif %}</span></div>
            {% endfor %}
        </section>
        <section>
            <h2 class="label">{{ headings.projects }}</h2>
            {% for project in project_items %}<a class="cv-aside__row" href="{{ cv_base }}{{ project.url }}"><span>{{ project.data.title }}</span><span>{{ project.data.start_date | date: '%Y' }}</span></a>
            {% endfor %}
        </section>
        <section class="cv-aside__formats no-print">
            <h2 class="label">{{ headings.other_formats }}</h2>
            <div>{% for format in formats %}{% assign format_lang = format.lang | default: "en" %}{% if format_lang == cv_lang and format.name != "PDF" %}<a href="{{ cv_base }}{{ format.url }}">{{ format.name }}</a>{% endif %}{% endfor %}</div>
        </section>
    </aside>
</div>
