{%- assign self = collections.all | findByInputPath: page.inputPath -%}
{%- assign alternates = self | hreflangAlternates: collections.all -%}
{%- capture nav_links -%}
  <a href="{{ headings.ui.home_url }}"{% if page.url == headings.ui.home_url %} aria-current="page"{% endif %}>{{ headings.ui.home }}</a>
  <a href="{{ headings.ui.cv_url }}"{% if page.url contains "/cv/" %} aria-current="page"{% endif %}>{{ headings.ui.cv }}</a>
  <a href="/blog/"{% if page.url contains "/blog/" %} aria-current="page"{% endif %}>{{ headings.ui.blog }}</a>
  <a href="{{ headings.ui.about_url }}"{% if page.url == headings.ui.about_url %} aria-current="page"{% endif %}>{{ headings.ui.about }}</a>
  {%- for alt in alternates -%}{%- if alt.lang != lang and alt.lang != "x-default" -%}
  <a class="nav-lang" href="{{ alt.path }}" hreflang="{{ alt.lang }}" lang="{{ alt.lang }}">{% if alt.lang == "sv" %}Svenska{% else %}English{% endif %}</a>
  {%- endif -%}{%- endfor -%}
{%- endcapture -%}
<header class="site-header no-print">
    <div class="wrap site-header__inner">
        <a class="brand" href="{{ headings.ui.home_url }}">
            <span class="brand__mark" aria-hidden="true">b</span>
            <span>{{ person.name }}</span>
        </a>
        <nav class="nav" aria-label="Main">
            {{ nav_links }}
        </nav>
        <div class="site-header__chat">
            <cv-chat collection="henrik" answer-position="below"></cv-chat>
        </div>
        <details class="nav-mobile">
            <summary aria-label="Menu">
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M3 7h16M3 15h16"/></svg>
            </summary>
            <nav class="nav-mobile__panel" aria-label="Main">
                {{ nav_links }}
            </nav>
        </details>
    </div>
</header>
{%- comment -%} Business card at the top of printed pages (the CV). Not shown on screen. {%- endcomment %}
<div class="print-card print">
    <picture>
        <img src="/assets/img/portrait-800x1199.jpg" alt="Photo of Henrik Becker" width="800" height="1199" />
    </picture>
    <div>
        <p class="print-card__name">{{ person.name }}</p>
        <p>{{ person.jobTitle }}</p>
        <section id="social" data-source="{{ page.url }}#education">
            <h2 class="hidden">Social</h2>
            <ul>
                <li><i class="fas fa-phone"></i> <span class="flip-text">&#51;&#52;&#32;&#51;&#56;&#32;&#50;&#50;&#52;&#32;&#51;&#55;&#32;&#54;&#52;&#43;</span></li>
                <li><i class="fas fa-envelope"></i> <span class="flip-text">&#101;&#115;&#46;&#103;&#110;&#105;&#116;&#108;&#117;&#115;&#110;&#111;&#99;&#45;&#114;&#101;&#107;&#99;&#101;&#98;&#64;&#107;&#105;&#114;&#110;&#101;&#104;</span></li>
                <li><i class="fas fa-globe"></i> www.henrikbecker.net</li>
            </ul>
        </section>
    </div>
</div>
